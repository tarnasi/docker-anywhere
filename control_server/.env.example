# Control Server — environment configuration template
# Copy to .env: cp .env.example .env

# Credentials shared with agents (must match agent .env API_KEY / HMAC_SECRET)
AGENT_API_KEY=change-me-to-a-random-32-char-minimum-api-key
AGENT_HMAC_SECRET=change-me-to-a-random-32-char-minimum-hmac-secret

# Operator credentials (for pushing commands / viewing history)
OPERATOR_API_KEY=change-me-operator-api-key-32-chars-min
OPERATOR_HMAC_SECRET=change-me-operator-hmac-secret-32-chars

# Security
MAX_TIMESTAMP_SKEW_SECONDS=300
MAX_HISTORY_ENTRIES=1000

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
