# Secure Polling Agent — environment configuration template
# Copy to .env and fill in values before running: cp .env.example .env

# ── Identity (required) ───────────────────────────────────────────────────────
AGENT_ID=prod-server-01
API_KEY=change-me-to-a-random-32-char-minimum-api-key
HMAC_SECRET=change-me-to-a-random-32-char-minimum-hmac-secret

# ── Control server (required) ─────────────────────────────────────────────────
CONTROL_SERVER_URL=https://control.example.com
POLL_INTERVAL_SECONDS=15
REQUEST_TIMEOUT_SECONDS=30

# ── Docker paths ──────────────────────────────────────────────────────────────
DOCKER_COMPOSE_FILE=/opt/app/docker-compose.yml
DOCKER_WORK_DIR=/opt/app

# ── Script execution ──────────────────────────────────────────────────────────
ALLOWED_SCRIPTS_DIR=/opt/app/scripts

# ── Protected actions ─────────────────────────────────────────────────────────
# Must match the token sent in server_reboot command params
REBOOT_CONFIRMATION_TOKEN=change-me-reboot-token-16chars

# ── Execution limits ──────────────────────────────────────────────────────────
COMMAND_TIMEOUT_SECONDS=300
MAX_OUTPUT_BYTES=1048576

# ── Rate limiting (/health endpoint) ──────────────────────────────────────────
HEALTH_RATE_LIMIT_REQUESTS=60
HEALTH_RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=/var/log/secure-agent/agent.log
LOG_LEVEL=INFO

# ── Local health server (monitoring only) ─────────────────────────────────────
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
