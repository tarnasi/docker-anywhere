# Simple agent service — runs as user saxon (change User= if needed)
#
#   sudo cp deploy/private-server/secure-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now secure-agent

[Unit]
Description=Docker Anywhere Agent
After=network.target docker.service

[Service]
Type=simple
User=saxon
Group=saxon
WorkingDirectory=/home/app/.docker/anywhere
EnvironmentFile=/home/app/.docker/anywhere/agent/.env
ExecStart=/home/app/.docker/anywhere/.venv/bin/uvicorn agent.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
